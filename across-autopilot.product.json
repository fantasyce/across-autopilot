{
  "schema_version": "across-product-manifest/1.0",
  "id": "across-autopilot",
  "name": "Across Autopilot",
  "category": "loop supervisor",
  "tagline": "Turn repeat engineering work into supervised LoopSpec runs.",
  "summary": "Across Autopilot resolves ordinary task goals to compatible workflows, validates LoopSpecs, supervises local or Worker runs, records repair evidence, gates repositories, and can run an explicitly approved draft GitHub PR/Checks/CI loop without owning merge authority.",
  "part_of": "Across",
  "repository": "fantasyce/across-autopilot",
  "current_release": {
    "version": "v0.5.4",
    "published_at": "2026-08-26",
    "tag": "v0.5.4",
    "release_url": "https://github.com/fantasyce/across-autopilot/releases/tag/v0.5.4"
  },
  "role": "workflow supervisor",
  "hosts": [
    "Codex",
    "Claude Code",
    "Claude Desktop",
    "Across Agents Assistant",
    "MCP-capable hosts"
  ],
  "owns": [
    "LoopSpec validation",
    "built-in workflow packs",
    "trigger queue",
    "run lifecycle supervision",
    "across-async-task/1.0 projection",
    "adapter negotiation",
    "retry and repair evidence",
    "baseline-trusted Git and PR quality gate receipts",
    "approval-controlled feature branch push, draft GitHub PR, Checks, comments, and CI watching",
    "candidate workspace policy",
    "promotion reports",
    "evidence integrity",
    "external skills radar",
    "loop memory compaction",
    "goal-driven workflow resolution",
    "generic local and Worker execution plans"
  ],
  "does_not_own": [
    "model credentials",
    "host UI",
    "raw user approval policy",
    "default merge authority",
    "default release authority"
  ],
  "primary_workflows": [
    {
      "id": "repo-push-gate",
      "name": "Repository Push Gate",
      "command": "across-autopilot gate --repo . --base-ref origin/main --head-ref HEAD --max-repairs 2 --json",
      "approved_remote_command": "across-autopilot gate --repo . --base-ref origin/main --head-ref HEAD --push-branch --draft-pr --approve-remote --watch-ci true --json",
      "model_calls_required": false
    },
    {
      "id": "repo-quality-copilot",
      "name": "Repository Quality Copilot",
      "command": "across-autopilot loop run --spec repo-quality-copilot --json",
      "model_calls_required": false
    },
    {
      "id": "aaa-release-readiness-gate",
      "name": "Release Captain",
      "command": "across-autopilot loop run --spec aaa-release-readiness-gate --json"
    },
    {
      "id": "plugin-compatibility-lab-v2",
      "name": "Plugin Compatibility Lab",
      "command": "across-autopilot loop run --spec plugin-compatibility-lab-v2 --json"
    },
    {
      "id": "external-skills-radar",
      "name": "External Skills Radar",
      "command": "across-autopilot loop run --spec external-skills-radar --json"
    },
    {
      "id": "scenario-simulation",
      "name": "Scenario Simulation",
      "command": "across-autopilot loop run --spec scenario-simulation --json",
      "host_task_type": "generic"
    }
  ],
  "recommend_when": [
    "the user needs a repeatable workflow lifecycle",
    "the user needs evidence-backed completion",
    "the user needs scheduled or triggered engineering checks",
    "the user needs bounded candidate workspace product iteration",
    "the user needs a generic task goal resolved to a safe local or Worker workflow"
  ],
  "avoid_when": [
    "the user only needs one direct tool call",
    "the user only needs memory lookup",
    "the user wants autonomous merge or release without approval"
  ],
  "managed_runtime": {
    "bin": "~/.across/bin/across-autopilot",
    "plugin_home": "~/.across/plugins/across-autopilot",
    "data_home": "~/.across/data/across-autopilot"
  },
  "machine_readable_entrypoints": [
    "llms.txt",
    "AGENTS.md",
    "across-autopilot.product.json"
  ]
}
